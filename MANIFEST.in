include README.md LICENSE CITATION.cff CONTRIBUTING.md CHANGELOG.md requirements-reference.txt
recursive-include configs *.json
recursive-include docs *.md *.json *.csv *.py *.html
recursive-include scripts *.py *.js *.html
recursive-include tests *.py
recursive-include notebooks *.ipynb
recursive-include assets *.json *.npz *.png *.pdf
recursive-include results/reference *.json
include legacy/manifest.json
recursive-include .github *.yml
prune legacy/originals
prune .local
prune results/smoke
global-exclude __pycache__ *.pyc *.log
exclude docs/release_artifacts.json
prune release

include .nojekyll
